---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ProductTable from '../components/ProductTable.astro';
import products from '../data/products.json';
import meta from '../data/meta.json';
import type { Product } from '../lib/types';
import { slugify } from '../lib/parse';

const allProducts = products as Product[];
const brands = [...new Set(allProducts.map((p) => p.brand))].sort();
const fitTypes = [...new Set(allProducts.map((p) => p.fitType))].sort();
---

<BaseLayout title="Alle opzetborstels">
  <h2>Alle opzetborstels, gesorteerd op prijs per kop</h2>
  <p>
    {meta.totalProducts} producten van {meta.sources.join(', ')}, laatst bijgewerkt op
    {new Date(meta.generatedAt).toLocaleDateString('nl-NL')}.
  </p>

  <div class="filters">
    <strong>Merk:</strong>
    {brands.map((b) => <a href={`/merk/${slugify(b)}/`}>{b}</a>)}
    <br />
    <strong>Type:</strong>
    {fitTypes.map((f) => <a href={`/type/${slugify(f)}/`}>{f}</a>)}
  </div>

  <p>
    <button id="sort-toggle" type="button">Sorteer: prijs per kop oplopend ↑</button>
  </p>

  <div id="product-table-wrap">
    <ProductTable products={allProducts} />
  </div>

  <HowItWorks />
</BaseLayout>

<script>
  // Mini client-side sort-toggle: wisselt de volgorde van de rijen in de
  // prijs-per-kop-tabel zonder een tweede serverside route nodig te hebben.
  const button = document.getElementById('sort-toggle');
  const table = document.querySelector('#product-table-wrap table tbody');
  let ascending = true;

  button?.addEventListener('click', () => {
    if (!table) return;
    const rows = Array.from(table.querySelectorAll('tr'));
    rows.reverse();
    rows.forEach((row) => table.appendChild(row));
    ascending = !ascending;
    button.textContent = `Sorteer: prijs per kop ${ascending ? 'oplopend ↑' : 'aflopend ↓'}`;
  });
</script>
