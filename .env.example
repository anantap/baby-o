# Kopieer dit bestand naar .env (gitignored) en vul de echte waarden in.
# Leeg laten is veilig: ontbrekende waarden resulteren in een duidelijke
# placeholder in de gegenereerde affiliate-link (__VAR_NIET_INGESTELD__) in
# plaats van een stille fout of een kapotte link.

# ---- Bol.com Marketing API / affiliate-programma ----
# Client credentials voor de Bol Marketing/Catalog API (OAuth2 client_credentials flow).
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=
# Site-ID uit het Bol partnerprogramma, wordt in elke affiliate-deeplink gezet.
BOL_SITE_ID=
# Alleen nodig als je de FTP-productfeed gebruikt i.p.v. de API.
BOL_FTP_HOST=
BOL_FTP_USER=
BOL_FTP_PASSWORD=

# ---- Generieke affiliate-netwerk feeds (TradeTracker / Daisycon / Awin) ----
# Eén URL + eventueel subId per drogist-feed. Voeg de bijbehorende entry toe
# in src/adapters/affiliate-feed.ts (FEED_CONFIGS) als je een nieuwe winkel toevoegt.
FEED_KRUIDVAT_URL=
FEED_KRUIDVAT_SUBID=

# ---- Amazon Product Advertising API (PA-API 5.0) ----
# Pas invullen zodra je Associates-account kwalificerende sales heeft (vereist
# voor API-toegang). Tot die tijd blijft src/adapters/amazon.ts uitgeschakeld
# in de registry (src/adapters/index.ts).
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_HOST=webservices.amazon.nl
AMAZON_REGION=eu-west-1
